rules_version = '2';

// MilkBook security model
// ----------------------
// Everything a shop owns lives under shops/{shopId}. A signed-in user may only
// touch a shop whose memberUids contains their uid, so two shops installed from
// the same Play listing can never see each other's khata.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function shopMembers(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.memberUids;
    }

    // Each user document only points at the shop they belong to.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /shops/{shopId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid in request.resource.data.memberUids;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // customers, deliveries, sales, payments, expenses, suppliers, …
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid in shopMembers(shopId);
      }
    }
  }
}
