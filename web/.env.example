# Firebase Console → Project settings → Your apps → Web app (</> icon)
#
# These are public identifiers, not secrets. They identify the project; they
# grant nothing. Access is enforced by the Firestore rules.
#
# Copy each value with the copy button in Firebase Console — do not retype the
# API key or app ID. A single wrong character (l vs I vs 1, O vs 0) fails with
# an error that does not mention the key at all.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
# Newer Firebase projects use `.firebasestorage.app`; older ones use
# `.appspot.com`. Copy whichever your console actually shows.
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
